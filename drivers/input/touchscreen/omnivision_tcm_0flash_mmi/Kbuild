# add -Wall to try to catch everything we can.
EXTRA_CFLAGS += -Wall
ifeq ($(DEVICE_MODULES_PATH),)
DEVICE_MODULES_PATH = $(srctree)
endif
$(warning DEVICE_MODULES_PATH=$(DEVICE_MODULES_PATH))
