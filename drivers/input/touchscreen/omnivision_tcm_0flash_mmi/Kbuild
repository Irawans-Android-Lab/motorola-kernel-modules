			omnivision_tcm_diagnostics.o


ifneq ($(filter m y,$(CONFIG_OVT_ENABLE_DOUBLE_TAP)),)
	EXTRA_CFLAGS += -DOVT_SENSOR_EN
	KBUILD_EXTRA_SYMBOLS += $(CURDIR)/$(KBUILD_EXTMOD)/../../../sensors/$(GKI_OBJ_MODULE_DIR)/Module.symvers
endif

ifneq ($(filter m y,$(CONFIG_TP_MTK_CHECK_PANEL)),)
	EXTRA_CFLAGS += -DOVT_MTK_CHECK_PANEL
endif


ifneq ($(filter m y, $(CONFIG_MTK_PANEL_NOTIFICATIONS)),)
